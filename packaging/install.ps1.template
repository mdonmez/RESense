#requires -Version 5.1

param(
    [string]$TargetExecutable,
    [int]$ParentProcessId = 0,
    [switch]$YesSkill,
    [switch]$NoSkill,
    [switch]$UpdateSkillIfPresent
)

$ErrorActionPreference = "Stop"

$BinaryUpdate = -not [string]::IsNullOrWhiteSpace($TargetExecutable)
$TargetStagePath = $null
$TargetBackupPath = $null
if ($BinaryUpdate) {
    if ($ParentProcessId -le 0) {
        throw "Binary update mode requires a valid parent process ID."
    }
    $TargetExecutable = [System.IO.Path]::GetFullPath($TargetExecutable)
    if (-not (Test-Path -LiteralPath $TargetExecutable -PathType Leaf)) {
        throw "The target executable '$TargetExecutable' does not exist."
    }
    $targetDirectory = Split-Path -Parent $TargetExecutable
    $TargetStagePath = Join-Path $targetDirectory (".resense-update-" + [guid]::NewGuid().ToString("N") + ".exe")
    $TargetBackupPath = Join-Path $targetDirectory (".resense-update-" + [guid]::NewGuid().ToString("N") + ".bak")
}

$Repository = "mdonmez/RESense"
$Version = "__VERSION__"
$ReleaseTag = "__RELEASE_TAG__"
$PackageName = "resense-$Version-windows-x86_64.zip"
$InstallPath = Join-Path $env:LOCALAPPDATA "Programs\RESense"
$InstallParent = Split-Path -Parent $InstallPath
$TemporaryRoot = Join-Path ([System.IO.Path]::GetTempPath()) ("resense-install-" + [guid]::NewGuid().ToString("N"))
$DownloadRoot = Join-Path $TemporaryRoot "download"
$ExtractRoot = Join-Path $TemporaryRoot "extract"
$StagePath = Join-Path $TemporaryRoot "stage"
$SkillInstallPath = Join-Path $HOME ".agents\skills\resense\SKILL.md"
$BaseUrl = "https://github.com/$Repository/releases/download/$ReleaseTag"

if (($YesSkill -and $NoSkill) -or
    ($YesSkill -and $UpdateSkillIfPresent) -or
    ($NoSkill -and $UpdateSkillIfPresent)) {
    throw "Choose only one of -YesSkill, -NoSkill, or -UpdateSkillIfPresent."
}
if ($UpdateSkillIfPresent -and -not $BinaryUpdate) {
    throw "-UpdateSkillIfPresent is only valid for a binary update."
}

function Test-InteractiveSession {
    try {
        return $null -ne $Host.UI -and $null -ne $Host.UI.RawUI -and -not [Console]::IsInputRedirected
    }
    catch {
        return $false
    }
}

function Resolve-SkillInstall {
    if ($UpdateSkillIfPresent) {
        return Test-Path -LiteralPath $SkillInstallPath -PathType Leaf
    }
    if ($YesSkill) {
        return $true
    }
    if ($NoSkill) {
        return $false
    }
    if (-not (Test-InteractiveSession)) {
        return $false
    }

    $answer = Read-Host "Install the RESense agent skill? [Y/n]"
    return [string]::IsNullOrWhiteSpace($answer) -or $answer -notmatch '^(n|no)$'
}

$InstallSkill = Resolve-SkillInstall

function Get-ExpectedChecksum {
    param(
        [Parameter(Mandatory = $true)]
        [string]$ChecksumsFile,
        [Parameter(Mandatory = $true)]
        [string]$AssetName
    )

    $matches = @(Get-Content -LiteralPath $ChecksumsFile | Where-Object {
        $parts = $_.Trim() -split "\s+", 2
        $parts.Count -eq 2 -and $parts[1].Trim() -eq $AssetName
    })
    if ($matches.Count -ne 1) {
        throw "SHA-256 entry for '$AssetName' was not found or was ambiguous."
    }

    $hash = (($matches[0].Trim() -split "\s+", 2)[0]).ToUpperInvariant()
    if ($hash -notmatch '^[A-F0-9]{64}$') {
        throw "SHA-256 entry for '$AssetName' is invalid."
    }
    return $hash
}

function Get-Sha256Hex {
    param(
        [Parameter(Mandatory = $true)]
        [string]$FilePath
    )

    $algorithm = $null
    $stream = $null
    try {
        $algorithm = [System.Security.Cryptography.SHA256]::Create()
        $stream = [System.IO.File]::OpenRead($FilePath)
        $hashBytes = $algorithm.ComputeHash($stream)
        return ([System.BitConverter]::ToString($hashBytes)).Replace('-', '').ToUpperInvariant()
    }
    finally {
        if ($null -ne $stream) {
            $stream.Dispose()
        }
        if ($null -ne $algorithm) {
            $algorithm.Dispose()
        }
    }
}

function Assert-Checksum {
    param(
        [Parameter(Mandatory = $true)]
        [string]$FilePath,
        [Parameter(Mandatory = $true)]
        [string]$AssetName,
        [Parameter(Mandatory = $true)]
        [string]$ChecksumsFile
    )

    $expectedHash = Get-ExpectedChecksum -ChecksumsFile $ChecksumsFile -AssetName $AssetName
    $actualHash = Get-Sha256Hex -FilePath $FilePath
    if ($actualHash -ne $expectedHash) {
        throw "SHA-256 verification failed for '$AssetName'."
    }
}

function Install-Skill {
    param(
        [Parameter(Mandatory = $true)]
        [string]$SourcePath
    )

    $skillDirectory = Split-Path -Parent $SkillInstallPath
    $skillStagePath = Join-Path $skillDirectory (".SKILL.md." + [guid]::NewGuid().ToString("N") + ".tmp")
    $skillBackupPath = Join-Path $skillDirectory (".SKILL.md." + [guid]::NewGuid().ToString("N") + ".bak")
    try {
        New-Item -ItemType Directory -Force -Path $skillDirectory | Out-Null
        Copy-Item -LiteralPath $SourcePath -Destination $skillStagePath -Force
        if (Test-Path -LiteralPath $SkillInstallPath -PathType Leaf) {
            [System.IO.File]::Replace($skillStagePath, $SkillInstallPath, $skillBackupPath, $true)
        }
        else {
            [System.IO.File]::Move($skillStagePath, $SkillInstallPath)
        }
    }
    catch {
        throw "Could not install the RESense skill at '$SkillInstallPath': $($_.Exception.Message)"
    }
    finally {
        if (Test-Path -LiteralPath $skillStagePath) {
            Remove-Item -LiteralPath $skillStagePath -Force -ErrorAction SilentlyContinue
        }
        if (Test-Path -LiteralPath $skillBackupPath) {
            Remove-Item -LiteralPath $skillBackupPath -Force -ErrorAction SilentlyContinue
        }
    }
}

try {
    if (-not $BinaryUpdate) {
        $running = @(Get-Process -Name "resense" -ErrorAction SilentlyContinue)
        if ($running.Count -gt 0) {
            throw "Close any running resense.exe process before updating RESense."
        }
    }

    New-Item -ItemType Directory -Force -Path $DownloadRoot, $ExtractRoot, $StagePath | Out-Null

    if ($BinaryUpdate) {
        $waitDeadline = (Get-Date).AddSeconds(60)
        while ($true) {
            $parent = Get-Process -Id $ParentProcessId -ErrorAction SilentlyContinue
            if ($null -eq $parent) {
                break
            }
            if ((Get-Date) -ge $waitDeadline) {
                throw "The original RESense process did not exit within 60 seconds."
            }
            Start-Sleep -Milliseconds 100
        }
    }

    $packagePath = Join-Path $DownloadRoot $PackageName
    $checksumsPath = Join-Path $DownloadRoot "SHA256SUMS.txt"
    Invoke-WebRequest -UseBasicParsing -TimeoutSec 30 -Uri "$BaseUrl/$PackageName" -OutFile $packagePath
    Invoke-WebRequest -UseBasicParsing -TimeoutSec 30 -Uri "$BaseUrl/SHA256SUMS.txt" -OutFile $checksumsPath
    if ($InstallSkill) {
        $skillDownloadPath = Join-Path $DownloadRoot "SKILL.md"
        Invoke-WebRequest -UseBasicParsing -TimeoutSec 30 -Uri "$BaseUrl/SKILL.md" -OutFile $skillDownloadPath
    }
    Assert-Checksum -FilePath $packagePath -AssetName $PackageName -ChecksumsFile $checksumsPath
    if ($InstallSkill) {
        Assert-Checksum -FilePath $skillDownloadPath -AssetName "SKILL.md" -ChecksumsFile $checksumsPath
    }

    Expand-Archive -LiteralPath $packagePath -DestinationPath $ExtractRoot -Force
    $executablePath = Join-Path $ExtractRoot "resense.exe"
    if (-not (Test-Path -LiteralPath $executablePath -PathType Leaf)) {
        throw "The release archive does not contain resense.exe."
    }
    $archiveEntries = @(Get-ChildItem -LiteralPath $ExtractRoot -Recurse)
    if ($archiveEntries.Count -ne 1 -or $archiveEntries[0].PSIsContainer -or $archiveEntries[0].Name -ne "resense.exe") {
        throw "The release archive must contain only resense.exe."
    }

    if ($BinaryUpdate) {
        Copy-Item -LiteralPath $executablePath -Destination $TargetStagePath -Force
        try {
            [System.IO.File]::Replace($TargetStagePath, $TargetExecutable, $TargetBackupPath, $true)
        }
        catch {
            throw "Could not replace '$TargetExecutable'. Close processes using it and try again."
        }

        if ($InstallSkill) {
            Install-Skill -SourcePath $skillDownloadPath
            Write-Output "RESense skill $Version installed at $SkillInstallPath."
        }
        Write-Output "RESense updated at $TargetExecutable."
        return
    }

    Copy-Item -LiteralPath $executablePath -Destination $StagePath -Force
    New-Item -ItemType Directory -Force -Path $InstallParent | Out-Null
    if (Test-Path -LiteralPath $InstallPath) {
        Remove-Item -LiteralPath $InstallPath -Recurse -Force
    }
    Move-Item -LiteralPath $StagePath -Destination $InstallPath

    $userPath = [Environment]::GetEnvironmentVariable("Path", "User")
    $userEntries = @()
    if (-not [string]::IsNullOrWhiteSpace($userPath)) {
        $userEntries = @($userPath -split ";" | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
    }
    $normalizedInstallPath = [System.IO.Path]::GetFullPath($InstallPath).TrimEnd("\")
    $pathAlreadyPresent = @($userEntries | Where-Object {
        [string]::Equals($_.Trim().TrimEnd("\"), $normalizedInstallPath, [StringComparison]::OrdinalIgnoreCase)
    }).Count -gt 0
    if (-not $pathAlreadyPresent) {
        [Environment]::SetEnvironmentVariable("Path", (($userEntries + $InstallPath) -join ";"), "User")
    }

    $currentEntries = @($env:Path -split ";" | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
    $currentPathPresent = @($currentEntries | Where-Object {
        [string]::Equals($_.Trim().TrimEnd("\"), $normalizedInstallPath, [StringComparison]::OrdinalIgnoreCase)
    }).Count -gt 0
    if (-not $currentPathPresent) {
        $env:Path = (($currentEntries + $InstallPath) -join ";")
    }

    if ($InstallSkill) {
        Install-Skill -SourcePath $skillDownloadPath
    }
    Write-Output "RESense $Version installed at $InstallPath."
    if ($InstallSkill) {
        Write-Output "RESense skill $Version installed at $SkillInstallPath."
    }
    Write-Output "Open a new terminal, or run 'resense --help' in this session."
}
finally {
    if ($TargetStagePath -and (Test-Path -LiteralPath $TargetStagePath)) {
        Remove-Item -LiteralPath $TargetStagePath -Force -ErrorAction SilentlyContinue
    }
    if ($TargetBackupPath -and (Test-Path -LiteralPath $TargetBackupPath)) {
        Remove-Item -LiteralPath $TargetBackupPath -Force -ErrorAction SilentlyContinue
    }
    if (Test-Path -LiteralPath $TemporaryRoot) {
        Remove-Item -LiteralPath $TemporaryRoot -Recurse -Force -ErrorAction SilentlyContinue
    }
}
